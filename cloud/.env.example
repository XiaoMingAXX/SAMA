# Local development. Never commit real credentials.
HOST=127.0.0.1
WEB_PORT=3180
PORT=3189
SAMA_PUBLIC_ORIGIN=http://127.0.0.1:3180
SAMA_ALLOW_REGISTRATION=true
SAMA_OBJECT_STORE=local
# Before deployment: NODE_ENV=production, HTTPS public origin, private OSS.
# SAMA_OBJECT_STORE=oss
# OSS_BUCKET=your-private-bucket
# OSS_ENDPOINT=https://oss-cn-chengdu-internal.aliyuncs.com
# Recommended: a dedicated application credential file, mounted as a Compose secret.
# OSS_CREDENTIALS_FILE=/run/secrets/oss_credentials
# SAMA_OSS_CREDENTIALS_FILE=./.secrets/oss-credentials.json
# Alternative for a separately reviewed deployment: ECS RAM role or environment credentials.
# OSS_RAM_ROLE_NAME=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_SECURITY_TOKEN=
